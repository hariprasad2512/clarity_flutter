# =============================================================================
# Clarity Flutter — environment template
# Copying is optional for Phase 1 (offline-first works with no keys).
# NEVER commit real values. Real `.env` is gitignored.
# Usage (later phases): flutter run --dart-define-from-file=.env
# =============================================================================

# =============================================================================
# Supabase (required for cloud sync — Phase 3; leave empty for local-only)
# =============================================================================
# Required: project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Required: anon/public key from Supabase Dashboard → Project Settings → API
SUPABASE_ANON_KEY=

# =============================================================================
# Google OAuth (required for sign-in — Phase 3; leave empty for local-only)
# =============================================================================
# iOS/macOS reversed client ID from GoogleService-Info.plist
GOOGLE_IOS_CLIENT_ID=
# Web client ID from Google Cloud Console (also used for Android serverAuthCode)
GOOGLE_WEB_CLIENT_ID=

# =============================================================================
# App behavior (optional, sensible defaults apply)
# =============================================================================
# "Remind me later" delay in minutes; options 15/30/60/120/180 (default 60)
SNOOZE_MINUTES_DEFAULT=60
# Set true to skip the login gate when Supabase is unconfigured (default true
# in debug, false in release)
OFFLINE_MODE=true
